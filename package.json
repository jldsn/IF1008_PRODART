{
  "name": "prodarte",
  "version": "0.1.0",
  "private": true,
  "description": "Plataforma de backoffice para gestão do programa PRODARTE — Prefeitura do Recife",
  "workspaces": [
    "apps/web/*",
    "packages/*"
  ],
  "scripts": {
    "setup:keys": "bash scripts/generate-jwt-keys.sh",
    "dev": "npm run dev -w apps/web/proarte-gestao-digital",
    "dev:web": "npm run dev -w apps/web/proarte-gestao-digital",
    "dev:api": "cd apps/api/gestaoartesaos && ./mvnw spring-boot:run",
    "build": "npm run build --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
